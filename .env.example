# Firebase Console -> Proje Ayarları -> Web uygulaması -> firebaseConfig değerleri
# Bu değerler gizli değildir (tarayıcıya gömülür); güvenliği firestore.rules sağlar.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Yerel geliştirme: Firebase Emulator Suite kullan (npm run emulators)
VITE_USE_EMULATORS=false
# Telefondan yerel ağ üzerinden test ederken bilgisayarın IP adresi (boşsa sayfanın host'u kullanılır)
VITE_EMULATOR_HOST=
