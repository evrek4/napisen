rules_version = '2';

// napisen - Firestore Güvenlik Kuralları
//
// - İzin listesi: allowlist/{email} belgeleri. Her kullanıcı yalnızca KENDİ kaydını okuyabilir;
//   listenin tamamını yalnızca yöneticiler görebilir. Kullanıcılar birbirlerini listeleyemez.
// - Kişi bulma: Her kullanıcının tahmin edilmesi zor bir kodu vardır (codes/{kod}). Kodu bilen
//   kişi bulunabilir. E-postayla bulunmak isteğe bağlıdır (users/{email}.discoverable).
// - Uygulama sahibi (OWNER) her zaman izinli ve yöneticidir; ilk kurulumda konsolda belge
//   oluşturmak gerekmez. Sahibi değiştirmek için aşağıdaki owner() fonksiyonunu düzenleyin.
// - Mesaj içerikleri uçtan uca şifreli olduğundan sunucu yalnızca şifreli veriyi görür.
service cloud.firestore {
  match /databases/{database}/documents {

    function owner() {
      return 'achartave@gmail.com';
    }

    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function me() {
      return request.auth.token.email.lower();
    }

    function entry(email) {
      return /databases/$(database)/documents/allowlist/$(email);
    }

    function allowedEmail(email) {
      return email is string && (email == owner() || exists(entry(email)));
    }

    function allowed() {
      return signedIn() && allowedEmail(me());
    }

    function isAdmin() {
      return signedIn()
        && (me() == owner() || (exists(entry(me())) && get(entry(me())).data.admin == true));
    }

    function participant(d) {
      return d.from == me() || d.to == me();
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(me())).data;
    }

    function validCode(code) {
      return code is string && code.matches('^[2-9A-HJ-NP-Z]{4}-[2-9A-HJ-NP-Z]{4}$');
    }

    function validPublicProfile(d) {
      return d.publicKey is string
        && d.publicKey.size() == 88
        && d.displayName is string
        && d.displayName.size() <= 80
        && d.updatedAt == request.time;
    }

    // ---------- İzin listesi ----------
    match /allowlist/{email} {
      // Kendi kaydını herkes okuyabilir (erişim kontrolü için); diğerlerini yalnızca yöneticiler
      allow get: if allowed() && (email == me() || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && email == email.lower()
        && email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
        && request.resource.data.keys().hasOnly(['admin', 'addedBy', 'addedAt'])
        && request.resource.data.admin is bool
        && request.resource.data.addedBy == me()
        && request.resource.data.addedAt == request.time
        // Yönetici kendi yetkisini kaldıramaz
        && (email != me() || request.resource.data.admin == true);
      allow delete: if isAdmin() && email != me() && email != owner();
    }

    // ---------- Kişi kodları (herkese açık profil, yalnızca kodu bilen okur) ----------
    match /codes/{code} {
      allow get: if allowed();
      allow list: if false;
      allow create: if allowed()
        && validCode(code)
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'publicKey', 'updatedAt'])
        && request.resource.data.email == me()
        && validPublicProfile(request.resource.data);
      allow update: if allowed()
        && resource.data.email == me()
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'publicKey', 'updatedAt'])
        && request.resource.data.email == me()
        && validPublicProfile(request.resource.data);
      allow delete: if allowed() && resource.data.email == me();
    }

    // ---------- Kullanıcı profilleri ----------
    // Yalnızca sahibi okuyabilir; sahibi "e-postayla bulunabilirim" dediyse diğerleri de okuyabilir.
    // Listeleme kapalı.
    match /users/{email} {
      allow get: if allowed() && (email == me() || resource.data.discoverable == true);
      allow list: if false;
      allow create, update: if allowed()
        && email == me()
        && request.resource.data.keys().hasOnly(
             ['email', 'displayName', 'publicKey', 'code', 'discoverable', 'updatedAt'])
        && request.resource.data.email == me()
        && validPublicProfile(request.resource.data)
        && request.resource.data.discoverable is bool
        // Kod gerçekten bu kullanıcıya ait olmalı
        && validCode(request.resource.data.code)
        && exists(/databases/$(database)/documents/codes/$(request.resource.data.code))
        && get(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.email == me();
      allow delete: if false;
    }

    // ---------- Mesajlar ----------
    match /messages/{id} {
      allow get, list: if allowed() && participant(resource.data);

      allow create: if allowed()
        && id.size() <= 64
        && request.resource.data.keys().hasOnly(
             ['from', 'to', 'fromPub', 'toPub', 'fromCode', 'toCode', 'keepOnServer', 'header', 'media',
              'status', 'createdAt'])
        && request.resource.data.from == me()
        && request.resource.data.to is string
        && request.resource.data.to != me()
        && allowedEmail(request.resource.data.to)
        // Gönderen, yayınladığı kendi açık anahtarını ve kodunu kullanmak zorunda
        && request.resource.data.fromPub == myProfile().publicKey
        && request.resource.data.fromCode == myProfile().code
        && (request.resource.data.toCode == null || validCode(request.resource.data.toCode))
        && request.resource.data.toPub is string
        && request.resource.data.toPub.size() == 88
        && request.resource.data.keepOnServer is bool
        && request.resource.data.status == 'sent'
        && request.resource.data.createdAt == request.time
        && request.resource.data.header.keys().hasOnly(['iv', 'ct'])
        && request.resource.data.header.ct is string
        && request.resource.data.header.ct.size() <= 20000
        && (request.resource.data.media == null
            || (request.resource.data.media.keys().hasOnly(['iv', 'size', 'chunks'])
                && request.resource.data.media.chunks is int
                && request.resource.data.media.chunks >= 1
                && request.resource.data.media.chunks <= 64));

      // Alıcı yalnızca "teslim edildi" olarak işaretleyebilir
      allow update: if allowed()
        && resource.data.to == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'delivered';

      // Alıcı teslim aldıktan sonra, gönderen ise geri çekmek için silebilir
      allow delete: if allowed() && participant(resource.data);

      // Şifreli medya parçaları
      match /chunks/{n} {
        allow get: if allowed() && participant(resource.data);
        allow create: if allowed()
          && request.resource.data.keys().hasOnly(['from', 'to', 'data'])
          && request.resource.data.from == me()
          && allowedEmail(request.resource.data.to)
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 600000;
        allow delete: if allowed() && participant(resource.data);
        allow list, update: if false;
      }
    }

    // ---------- Cihaz taşıma (şifreli, tek kullanımlık) ----------
    match /transfers/{email} {
      allow get, delete: if allowed() && email == me();
      allow create, update: if allowed()
        && email == me()
        && request.resource.data.keys().hasOnly(['oldPub', 'iv', 'ct', 'createdAt'])
        && request.resource.data.ct is string
        && request.resource.data.ct.size() <= 100000
        && request.resource.data.createdAt == request.time;
    }

    // Eski sürümden kalan config/* belgeleri artık kullanılmaz
    match /config/{doc} {
      allow read, write: if false;
    }
  }
}
